msgid "EveryAlt can no longer read your saved %1$s API key, usually because the security keys in wp-config.php changed. Generation with that provider is paused until you <a href=\"%2$s\">re-enter the key</a>."
msgstr "EveryAlt kann deinen gespeicherten %1$s-API-Schlüssel nicht mehr lesen, meist weil sich die Sicherheitsschlüssel in wp-config.php geändert haben. Die Generierung mit diesem Anbieter ist pausiert, bis du <a href=\"%2$s\">den Schlüssel erneut eingibst</a>."

#. translators: 1: spent this month, 2: monthly limit, 3: settings URL
#: admin/class-everyalt-admin.php:278
#, php-format
msgid "EveryAlt has paused: this month’s estimated spend (%1$s) reached your monthly limit of %2$s. New images will be processed next month, or you can <a href=\"%3$s\">raise the limit</a>."
msgstr "EveryAlt ist pausiert: Die geschätzten Ausgaben dieses Monats (%1$s) haben dein Monatslimit von %2$s erreicht. Neue Bilder werden im nächsten Monat verarbeitet, oder du kannst <a href=\"%3$s\">das Limit erhöhen</a>."

#: admin/class-everyalt-admin.php:293
msgid "You do not have permission to do this."
msgstr "Du hast keine Berechtigung dafür."

#: admin/class-everyalt-admin.php:297
msgid "Unknown provider."
msgstr "Unbekannter Anbieter."

#: admin/class-everyalt-admin.php:304
