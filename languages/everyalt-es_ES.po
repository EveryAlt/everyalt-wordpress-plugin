#: admin/class-everyalt-admin.php:259
#, php-format
msgid "EveryAlt can no longer read your saved %1$s API key, usually because the security keys in wp-config.php changed. Generation with that provider is paused until you <a href=\"%2$s\">re-enter the key</a>."
msgstr "EveryAlt ya no puede leer tu clave API de %1$s guardada, normalmente porque cambiaron las claves de seguridad de wp-config.php. La generación con ese proveedor está en pausa hasta que <a href=\"%2$s\">vuelvas a introducir la clave</a>."

#. translators: 1: spent this month, 2: monthly limit, 3: settings URL
#: admin/class-everyalt-admin.php:278
#, php-format
msgid "EveryAlt has paused: this month’s estimated spend (%1$s) reached your monthly limit of %2$s. New images will be processed next month, or you can <a href=\"%3$s\">raise the limit</a>."
msgstr "EveryAlt está en pausa: el gasto estimado de este mes (%1$s) ha alcanzado tu límite mensual de %2$s. Las nuevas imágenes se procesarán el mes que viene, o puedes <a href=\"%3$s\">aumentar el límite</a>."

#: admin/class-everyalt-admin.php:293
msgid "You do not have permission to do this."
msgstr "No tienes permiso para hacer esto."

#: admin/class-everyalt-admin.php:297
msgid "Unknown provider."
msgstr "Proveedor desconocido."

#: admin/class-everyalt-admin.php:304
msgid "Enter an API key in the field above, or save a key first to validate the stored key."
msgstr "Introduce una clave API en el campo de arriba, o guarda primero una clave para validar la clave almacenada."

#: admin/class-everyalt-admin.php:307
msgid "API key is valid."
msgstr "La clave API es válida."

#: admin/class-everyalt-admin.php:309
msgid "API key could not be validated. Check that the key is correct and has API access."
msgstr "No se pudo validar la clave API. Comprueba que la clave sea correcta y tenga acceso a la API."

#: admin/class-everyalt-admin.php:423
#, php-format
msgid "Generating in the background: %d remaining. You can leave this page; it continues on its own."
msgstr "Generando en segundo plano: quedan %d. Puedes salir de esta página; el proceso continúa por sí solo."

#: admin/class-everyalt-admin.php:424
#, php-format
msgid "%d waiting to retry. They will be tried again automatically."
msgstr "%d a la espera de reintento. Se volverán a intentar automáticamente."

#: admin/class-everyalt-admin.php:425
msgid "All done."
msgstr "Todo listo."

#: admin/class-everyalt-admin.php:426
msgid "Paused: monthly spending limit reached. Raise the limit in Settings or wait until next month."
msgstr "En pausa: se alcanzó el límite de gasto mensual. Aumenta el límite en Ajustes o espera al mes que viene."

#: admin/class-everyalt-admin.php:427
msgid "Paused: add an API key for the selected model in Settings."
msgstr "En pausa: añade una clave API para el modelo seleccionado en Ajustes."

