#. translators: 1: input price in USD, 2: output price in USD
#: admin/partials/everyalt-options-display.php:90
#, php-format
msgid "$%1$s input · $%2$s output per 1M tokens"
msgstr "$%1$s invoer · $%2$s uitvoer per 1 miljoen tokens"

#: admin/partials/everyalt-options-display.php:101
msgid "All models read the image and write alt text and titles the same way. Prices are each provider’s published rates as of September 2026 and may change. You pay the provider directly; EveryAlt never bills you. The actual cost of each image is recorded on the Logs tab."
msgstr "Alle modellen lezen de afbeelding en schrijven alt-tekst en titels op dezelfde manier. De prijzen zijn de gepubliceerde tarieven van elke provider per september 2026 en kunnen veranderen. Je betaalt de provider rechtstreeks; EveryAlt brengt je nooit iets in rekening. De werkelijke kosten per afbeelding worden vastgelegd op het tabblad Logboeken."

#. translators: %s: provider name, e.g. OpenAI
#: admin/partials/everyalt-options-display.php:108
#, php-format
msgid "%s pricing"
msgstr "Prijzen van %s"

#: admin/partials/everyalt-options-display.php:116
msgid "API key"
msgstr "API-sleutel"

#. translators: %s: provider name, e.g. OpenAI
#: admin/partials/everyalt-options-display.php:127
#, php-format
msgid "%s API key"
