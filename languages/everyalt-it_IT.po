msgstr "Testo alternativo generato."

#: admin/class-everyalt-admin.php:463
msgid "Could not generate alt text."
msgstr "Impossibile generare il testo alternativo."

#: admin/class-everyalt-admin.php:464
msgid "Marked as decorative: alt text left empty on purpose."
msgstr "Contrassegnata come decorativa: testo alternativo lasciato vuoto di proposito."

#: admin/class-everyalt-admin.php:585
msgid "Skipped: no API key or auto-generate disabled."
msgstr "Saltato: nessuna chiave API o generazione automatica disattivata."

#: admin/class-everyalt-admin.php:590
msgid "Skipped: API key validation failed."
msgstr "Saltato: validazione della chiave API fallita."

#: admin/class-everyalt-admin.php:600
