#. translators: 1: provider name(s), e.g. "OpenAI", 2: URL of the EveryAlt settings tab
#: admin/class-everyalt-admin.php:264
#, php-format
msgid "EveryAlt can no longer read your saved %1$s API key, usually because the security keys in wp-config.php changed. Generation with that provider is paused until you <a href=\"%2$s\">re-enter the key</a>."
msgstr "EveryAlt non riesce più a leggere la chiave API %1$s salvata, di solito perché le chiavi di sicurezza in wp-config.php sono cambiate. La generazione con questo provider è in pausa finché non <a href=\"%2$s\">reinserisci la chiave</a>."

#. translators: 1: spent this month, 2: monthly limit, 3: settings URL
#: admin/class-everyalt-admin.php:283
#, php-format
msgid "EveryAlt has paused: this month’s estimated spend (%1$s) reached your monthly limit of %2$s. New images will be processed next month, or you can <a href=\"%3$s\">raise the limit</a>."
msgstr "EveryAlt è in pausa: la spesa stimata di questo mese (%1$s) ha raggiunto il tuo limite mensile di %2$s. Le nuove immagini verranno elaborate il mese prossimo, oppure puoi <a href=\"%3$s\">aumentare il limite</a>."

#: admin/class-everyalt-admin.php:298
msgid "You do not have permission to do this."
msgstr "Non hai il permesso di fare questa operazione."

#: admin/class-everyalt-admin.php:302
msgid "Unknown provider."
msgstr "Provider sconosciuto."

#: admin/class-everyalt-admin.php:309
msgid "Enter an API key in the field above, or save a key first to validate the stored key."
msgstr "Inserisci una chiave API nel campo sopra, oppure salva prima una chiave per validare quella memorizzata."

#: admin/class-everyalt-admin.php:312
msgid "API key is valid."
msgstr "La chiave API è valida."

#: admin/class-everyalt-admin.php:314
msgid "API key could not be validated. Check that the key is correct and has API access."
msgstr "Impossibile validare la chiave API. Verifica che la chiave sia corretta e abbia accesso all'API."

#: admin/class-everyalt-admin.php:428
#, php-format
msgid "Generating in the background: %d remaining. You can leave this page; it continues on its own."
msgstr "Generazione in background: %d rimanenti. Puoi lasciare questa pagina; il processo continua da solo."

#: admin/class-everyalt-admin.php:429
#, php-format
msgid "%d waiting to retry. They will be tried again automatically."
msgstr "%d in attesa di un nuovo tentativo. Verranno ritentati automaticamente."

#: admin/class-everyalt-admin.php:430
msgid "All done."
msgstr "Tutto fatto."

#: admin/class-everyalt-admin.php:431
msgid "Paused: monthly spending limit reached. Raise the limit in Settings or wait until next month."
msgstr "In pausa: limite di spesa mensile raggiunto. Aumenta il limite in Impostazioni o attendi il mese prossimo."

#: admin/class-everyalt-admin.php:432
msgid "Paused: add an API key for the selected model in Settings."
msgstr "In pausa: aggiungi una chiave API per il modello selezionato in Impostazioni."

#: admin/class-everyalt-admin.php:433
#, php-format
msgid "Added %d images to the queue."
msgstr "Aggiunte %d immagini alla coda."

#: admin/class-everyalt-admin.php:434
msgid "Those images were already queued."
msgstr "Queste immagini erano già in coda."

#: admin/class-everyalt-admin.php:435
msgid "Queue cleared."
msgstr "Coda svuotata."

#: admin/class-everyalt-admin.php:436
msgid "Marked as decorative (alt text left empty on purpose)"
msgstr "Contrassegnata come decorativa (testo alternativo lasciato vuoto di proposito)"

