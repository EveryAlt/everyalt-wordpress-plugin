msgstr "Contrassegnata come decorativa (testo alternativo lasciato vuoto di proposito)."

#: admin/class-everyalt-admin.php:630
msgid "No alt text returned from API."
msgstr "L'API non ha restituito testo alternativo."

#: admin/class-everyalt-admin.php:656
