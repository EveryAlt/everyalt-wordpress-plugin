msgstr "Seleziona o carica un'immagine per generare il testo alternativo."

#: admin/class-everyalt-admin.php:454
msgid "Generating…"
msgstr "Generazione in corso…"

#: admin/class-everyalt-admin.php:455
msgid "Alt text generated."
msgstr "Testo alternativo generato."

#: admin/class-everyalt-admin.php:456
msgid "Could not generate alt text."
msgstr "Impossibile generare il testo alternativo."

#: admin/class-everyalt-admin.php:457
msgid "Marked as decorative: alt text left empty on purpose."
msgstr "Contrassegnata come decorativa: testo alternativo lasciato vuoto di proposito."

#: admin/class-everyalt-admin.php:578
msgid "Skipped: no API key or auto-generate disabled."
msgstr "Saltato: nessuna chiave API o generazione automatica disattivata."

#: admin/class-everyalt-admin.php:583
msgid "Skipped: API key validation failed."
msgstr "Saltato: validazione della chiave API fallita."

#: admin/class-everyalt-admin.php:593
msgid "Skipped: not a valid image or file exceeds 4MB."
msgstr "Saltato: immagine non valida o file superiore a 4 MB."

#: admin/class-everyalt-admin.php:616
