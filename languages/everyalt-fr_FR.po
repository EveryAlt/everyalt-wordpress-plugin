msgstr "Clé enregistrée"

#: admin/partials/everyalt-options-display.php:141
msgid "No key saved"
msgstr "Aucune clé enregistrée"

#: admin/partials/everyalt-options-display.php:145
msgid "Leave blank to keep existing key"
msgstr "Laisser vide pour conserver la clé actuelle"

#: admin/partials/everyalt-options-display.php:145
msgid "Paste your API key"
msgstr "Collez votre clé API"

#: admin/partials/everyalt-options-display.php:146
