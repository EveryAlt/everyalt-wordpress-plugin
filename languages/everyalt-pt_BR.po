msgid "The %s API key you entered could not be validated. Please check the key and try again. No settings were saved."
msgstr "A chave de API de %s que você digitou não pôde ser validada. Verifique a chave e tente novamente. Nenhuma configuração foi salva."

#: admin/partials/everyalt-options-display.php:56
msgid "Clear queue"
msgstr "Limpar fila"

#: admin/partials/everyalt-options-display.php:58
msgid "Recent results"
msgstr "Resultados recentes"

#: admin/partials/everyalt-options-display.php:76
#: admin/partials/everyalt-options-display.php:79
