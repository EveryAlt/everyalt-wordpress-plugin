msgstr "Digite uma chave de API no campo acima ou salve uma chave primeiro para validar a chave armazenada."

#: admin/class-everyalt-admin.php:307
msgid "API key is valid."
msgstr "A chave de API é válida."

#: admin/class-everyalt-admin.php:309
